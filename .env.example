# Local development defaults only. The app has a local-only fallback secret when DJANGO_DEBUG=true.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ACCOUNT_EMAIL_VERIFICATION=none

# Before production: set DJANGO_DEBUG=false, a unique 50+ character DJANGO_SECRET_KEY,
# your real hostnames, an SMTP/email backend plus EMAIL_HOST/EMAIL_PORT/EMAIL_USE_TLS/
# EMAIL_HOST_USER/EMAIL_HOST_PASSWORD/DEFAULT_FROM_EMAIL, and mandatory email verification.
# Enable DJANGO_HSTS_INCLUDE_SUBDOMAINS and DJANGO_HSTS_PRELOAD only after confirming
# every subdomain is HTTPS-only and the domain is eligible for HSTS preload.
